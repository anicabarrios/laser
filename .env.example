# Copy this file to .env.local and fill it in. Never commit .env.local.

# Public address of the site (used for Stripe's success/cancel links).
# Leave empty in development: http://localhost:3000 is used automatically.
NEXT_PUBLIC_SITE_URL=

# Stripe: Dashboard > Developers > API keys (use the TEST keys first)
STRIPE_SECRET_KEY=
# Stripe: Developers > Webhooks > your endpoint > Signing secret
# (for local testing, `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints one)
STRIPE_WEBHOOK_SECRET=

# Supabase: Project settings > API
SUPABASE_URL=
# The "service_role" key. SECRET: server only, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
